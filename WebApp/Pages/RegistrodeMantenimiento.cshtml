@page
@model WebApp.Pages.RegistroDeMantenimientoModel
@{
    Layout = null;
    ViewData["Title"] = "Gestión de Mantenimientos";
}
<link rel="stylesheet" href="~/css/paneladministrador.css" />
<link rel="stylesheet" href="~/css/cerrarsesion.css" />
<link rel="stylesheet" href="~/css/gestiondeturbinas.css" />
<link rel="stylesheet" href="~/css/registrodeusuario.css" />
<link rel="stylesheet" href="~/css/registrodemantenimiento.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/ControlActions.js"></script>
<script src="~/js/pages-controllers/MantenimientoViewController.js"></script>
<div class="dashboard-container">
    <!-- ===== HEADER ===== -->
    <header class="app-header">
        <div class="logo-mark">ALPHA <span>ENERGY</span></div>
        <div class="user-chip">
            <div class="avatar-circle">IO</div>
            <div>
                <div class="user-name">Ing. Operaciones</div>
                <div class="user-role">Ingeniero</div>
            </div>
        </div>
    </header>
    <!-- ===== LAYOUT (sidebar + contenido) ===== -->
    <div class="app-layout">
        <!-- ===== sidebar ===== -->
        <nav class="app-sidebar">
            <div class="s-label">Menu</div>
            <a class="s-item" asp-page="/PanelAdministrador">Dashboard</a>
            <a class="s-item" asp-page="/GestionDeUsuarios">Usuarios</a>
            <a class="s-item" asp-page="/GestionDeTurbinas">Turbinas</a>
            <a class="s-item active" asp-page="/RegistroDeMantenimiento">Mantenimiento</a>
            <a class="s-item" asp-page="/PortalDistribuidor">Distribución</a>
            <a class="s-item" asp-page="/ReporteDeFacturacion">Reportes</a>
            <a class="s-item" asp-page="/Auditoria">Auditoría</a>
            <a class="s-item logout" href="/Login">Cerrar sesión</a>
        </nav>
        <!-- ===== CONTENIDO ===== -->
        <main class="app-content">
            <!-- ===== TÍTULO ===== -->
            <div class="page-title-row">
                <div>
                    <div class="page-title">Gestión de Mantenimientos</div>
                    <div class="page-sub">Planificación y seguimiento de mantenimientos de turbinas</div>
                </div>
                <button class="btn-primary" id="btnRegistrarMantenimiento">+ Registrar Mantenimiento</button>
            </div>
            <!-- ===== ESTADÍSTICAS ===== -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Total Mantenimientos</div>
                    <div class="stat-value" id="statTotalMant">0</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">En Proceso</div>
                    <div class="stat-value" id="statEnProceso">0</div>
                    <div class="stat-delta" id="statEnProcesoDelta" style="color:#1e40af;"></div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Programados</div>
                    <div class="stat-value" id="statProgramados">0</div>
                    <div class="stat-delta yellow" id="statProgramadosDelta"></div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Finalizados</div>
                    <div class="stat-value" id="statFinalizados">0</div>
                    <div class="stat-delta green" id="statFinalizadosDelta"></div>
                </div>
            </div>
            <!-- ===== FILTROS ===== -->
            <div class="filters-row">
                <div class="search-box-wrapper">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="search-icon">
                        <circle cx="7" cy="7" r="5" stroke="#aaa" stroke-width="1.5" />
                        <path d="M11 11l3 3" stroke="#aaa" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <input id="searchInputMant" type="text" placeholder="Buscar por turbina o tipo..." />
                </div>
                <select id="selFiltroTipoMant" class="filter-btn">
                    <option value="">Todos (Tipo)</option>
                    <option value="Planificado">Planificado</option>
                    <option value="No planificado">No planificado</option>
                </select>
                <select id="selFiltroEstadoMant" class="filter-btn">
                    <option value="">Todos (Estado)</option>
                    <option value="En Proceso">En Proceso</option>
                    <option value="Programado">Programado</option>
                    <option value="Finalizado">Finalizado</option>
                </select>
            </div>
            <!-- ===== TABLA ===== -->
            <table class="wf-table">
                <thead>
                    <tr>
                        <th>Turbina</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Inicio</th>
                        <th>Fin (estimado)</th>
                        <th>Registrado por</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyMantenimientos">
                </tbody>
            </table>
            <!-- ===== PAGINACIÓN ===== -->
            <div class="pagination-row">
                <span class="pagination-info" id="paginationInfoMant">Mostrando 0 de 0 mantenimientos</span>
            </div>
            <!-- ===== ANOTACIÓN ===== -->
            <div class="annotation-section">
                <span class="ann">🔧 Las turbinas con mantenimiento "En Proceso" están fuera de operación actualmente</span>
            </div>
        </main>
    </div>
    <!-- ===== FOOTER ===== -->
    <footer class="wf-footer">
        <p>&copy; 2026 Alpha Energy. Todos los derechos reservados.</p>
    </footer>
    <!-- ===== MODAL: FORMULARIO DE MANTENIMIENTO ===== -->
    <div class="modal-overlay" id="modalOverlayMant" style="display:none;">
        <div class="modal-card">
            <div class="modal-header">
                <button type="button" class="modal-close" id="btnCerrarModalMant">x</button>
                <h2 id="modalTitleMant">Registrar Mantenimiento</h2>
            </div>
            <!-- ===== SECCIÓN TURBINA ===== -->
            <div class="form-group">
                <label class="field-label">Turbina</label>
                <select id="selTurbinaMantenimiento" class="field-input">
                    <option value="">Seleccionar turbina...</option>
                </select>
                <div class="field-hint">Seleccione la turbina a intervenir</div>
                <div class="field-rule">
                    <span class="ann">Regla:</span> Mínimo 1 mantenimiento por mes por turbina.
                </div>
            </div>
            <!-- ===== SECCIÓN TIPO DE MANTENIMIENTO ===== -->
            <div class="form-group">
                <label class="field-label">Tipo de Mantenimiento</label>
                <div class="radio-row">
                    <label class="radio-item">
                        <input type="radio" name="tipoMantenimiento" value="Planificado" checked />
                        <span>Planificado</span>
                    </label>
                    <label class="radio-item">
                        <input type="radio" name="tipoMantenimiento" value="No planificado" />
                        <span>No planificado (Emergencia)</span>
                    </label>
                </div>
                <div class="field-hint">Planificado: se registra con anticipación (otro día, semana o mes). No planificado: se registra al detectar una falla.</div>
            </div>
            <hr class="wf-divider">
            <!-- ===== SECCIÓN FECHAS ===== -->
            <div class="form-group">
                <label class="field-label">Fecha y Hora de Inicio</label>
                <div class="date-row">
                    <input id="txtFechaInicioMant" type="date" class="field-input" />
                    <input id="txtHoraInicioMant" type="time" class="field-input" />
                </div>
            </div>
            <div class="form-group" id="grupoFechaFinMant">
                <label class="field-label">Fecha y Hora de Fin (estimada)</label>
                <div class="date-row">
                    <input id="txtFechaFinMant" type="date" class="field-input" />
                    <input id="txtHoraFinMant" type="time" class="field-input" />
                </div>
            </div>
            <hr class="wf-divider">
            <!-- ===== SECCIÓN DESCRIPCIÓN ===== -->
            <div class="form-group">
                <label class="field-label">Descripción del Trabajo</label>
                <textarea id="txtDescripcionMant" class="field-input textarea-field" placeholder="Describa los trabajos a realizar..." maxlength="500"></textarea>
                <div class="field-hint">Máximo 500 caracteres</div>
            </div>
            <!-- ===== ANOTACIONES ===== -->
            <div class="annotation-group">
                <div class="annotation-item">
                    <span class="ann">Campos validados antes de guardar. Fechas deben ser coherentes.</span>
                </div>
                <div class="annotation-item">
                    <span class="ann">No pueden coincidir dos mantenimientos en la misma ventana de tiempo (mismo día y misma hora) en la misma turbina.</span>
                </div>
                <div class="annotation-item">
                    <span class="ann">El estado (Programado / En Proceso / Finalizado) se calcula automáticamente según las fechas ingresadas.</span>
                </div>
            </div>
            <!-- ===== BOTONES ===== -->
            <div class="buttons-row">
                <button type="button" class="btn-primary" id="btnGuardarMantenimiento">Guardar</button>
                <button type="button" class="btn-outline" id="btnCancelarMant">Cancelar</button>
            </div>
        </div>
    </div>
</div>
