@page
@model WebApp.Pages.GestionDeUsuariosModel

@{
    Layout = null;
    ViewData["Title"] = "Gestión de Usuarios";
}

<link rel="stylesheet" href="~/css/paneladministrador.css" />
<link rel="stylesheet" href="~/css/cerrarsesion.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<link href="https://cdn.datatables.net/2.3.8/css/dataTables.dataTables.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/gestiondeusuarios.css" />
<script src="https://cdn.datatables.net/2.3.8/js/dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/ControlActions.js"></script>
<script src="~/js/pages-controllers/UserViewController.js"></script>

<div class="dashboard-container">

    <!-- ===== HEADER ===== -->
    <header class="app-header">
        <div class="logo-mark">ALPHA <span>ENERGY</span></div>
        <div class="user-chip">
            <div class="avatar-circle">AD</div>
            <div>
                <div class="user-name">Admin Principal</div>
                <div class="user-role">Administrador</div>
            </div>
        </div>
    </header>

    <!-- ===== LAYOUT (sidebar + contenido) ===== -->
    <div class="app-layout">

        <!-- ===== sidebar ===== -->
        <nav class="app-sidebar">
            <div class="s-label">Menu</div>
            <a class="s-item" asp-page="/PanelAdministrador">Dashboard</a>
            <a class="s-item active" asp-page="/GestionDeUsuarios">Usuarios</a>
            <a class="s-item" asp-page="/GestionDeTurbinas">Turbinas</a>
            <a class="s-item" asp-page="/RegistroDeMantenimiento">Mantenimiento</a>
            <a class="s-item" asp-page="/PortalDistribuidor">Distribución</a>
            <a class="s-item" asp-page="/ReporteDeFacturacion">Reportes</a>
            <a class="s-item" asp-page="/Auditoria">Auditoría</a>
            <a class="s-item logout" href="/Login">Cerrar sesión</a>
        </nav>

        <!-- ===== CONTENIDO ===== -->
        <main class="app-content">

            <!-- ===== TÍTULO ===== -->
            <div class="page-title-row">
                <div>
                    <div class="page-title">Usuarios del Sistema</div>
                    <div class="page-sub">Gestión de cuentas y permisos</div>
                </div>
                <button class="btn-primary" id="btnCreate">+ Agregar Usuario</button>
            </div>

            <!-- ===== ESTADÍSTICAS ===== -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Total Usuarios</div>
                    <div class="stat-value" id="statTotal">0</div>
                    <div class="stat-delta gray">Registrados en el sistema</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Administradores</div>
                    <div class="stat-value" id="statAdmins">0</div>
                    <div class="stat-delta gray">Rol asignado</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Distribuidores</div>
                    <div class="stat-value" id="statDistribuidores">0</div>
                    <div class="stat-delta gray">Rol asignado</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Nuevos este Mes</div>
                    <div class="stat-value" id="statNuevos">0</div>
                    <div class="stat-delta gray">Registros recientes</div>
                </div>
            </div>

            <!-- ===== FILTROS ===== -->
            <div class="filters-row">
                <div class="search-box">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                        <circle cx="7" cy="7" r="5" stroke="#aaa" stroke-width="1.5" />
                        <path d="M11 11l3 3" stroke="#aaa" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <input id="txtBuscarUsuario" type="text" placeholder="Buscar por nombre, correo o identificación..." />
                </div>
                <select id="selFiltroRol" class="filter-btn">
                    <option value="">Todos los roles</option>
                    <option value="1">Administrador</option>
                    <option value="2">Distribuidor</option>
                </select>
                <button class="filter-btn" id="btnFiltroFecha">Fecha de Registro ▽</button>
            </div>

            <!-- ===== TABLA (DataTables construye thead/tbody automáticamente) ===== -->
            <table id="tblUsers" class="wf-table">
            </table>

            <!-- ===== ANOTACIÓN ===== -->
            <div class="annotation-section">
                <span class="ann">👤 Usa los íconos de la columna "Acciones" para editar o eliminar un usuario</span>
            </div>

        </main>

    </div>

    <!-- ===== FOOTER ===== -->
    <footer class="wf-footer">
        <p>&copy; 2026 Alpha Energy. Todos los derechos reservados.</p>
    </footer>

    <!-- ===== MODAL CREAR/EDITAR USUARIO ===== -->
    <div id="modalOverlay" class="modal-overlay" style="display:none;">
        <div class="modal-box">
            <div class="modal-header">
                <h2 id="modalTitle">Agregar Usuario</h2>
                <button id="btnCerrarModal" class="modal-close">✕</button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="txtId" />

                <div class="form-group">
                    <label class="field-label">Identificación</label>
                    <input id="txtIdentificacion" class="field-input" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="field-label">Nombre</label>
                        <input id="txtNombre" class="field-input" />
                    </div>
                    <div class="form-group">
                        <label class="field-label">Primer Apellido</label>
                        <input id="txtApellido1" class="field-input" />
                    </div>
                    <div class="form-group">
                        <label class="field-label">Segundo Apellido</label>
                        <input id="txtApellido2" class="field-input" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="field-label">Correo</label>
                        <input id="txtCorreo" type="email" class="field-input" />
                    </div>
                    <div class="form-group">
                        <label class="field-label">Teléfono</label>
                        <input id="txtTelefono" class="field-input" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="field-label">Fecha de Nacimiento</label>
                        <input id="txtFechaNacimiento" type="date" class="field-input" />
                    </div>
                    <div class="form-group">
                        <label class="field-label">Contraseña</label>
                        <input id="txtContrasena" type="password" class="field-input" placeholder="Dejar en blanco para no cambiar" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="field-label">Foto de Perfil (URL)</label>
                    <input id="txtFotoPerfil" class="field-input" />
                </div>
            </div>

            <div class="modal-footer">
                <button id="btnCancelarModal" class="btn-outline">Cancelar</button>
                <button id="btnGuardarModal" class="btn-primary">Agregar</button>
            </div>
        </div>
    </div>

</div>