@page
@model WebApp.Pages.GestionDeTurbinasModel
@{
    Layout = null;
    ViewData["Title"] = "Gestión de Turbinas";
}
<link rel="stylesheet" href="~/css/paneladministrador.css" />
<link rel="stylesheet" href="~/css/cerrarsesion.css" />
<link rel="stylesheet" href="~/css/gestiondeturbinas.css" />
<link rel="stylesheet" href="~/css/registrodeusuario.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/ControlActions.js"></script>
<script>
    var ca = new ControlActions();
    if (ca.VerificarAccesoPagina([1, 3])) {
    $(document).ready(function () {
    ca.AplicarPermisosSidebar();
    ca.RellenarHeaderUsuario();
    });
    }
</script>
<script src="~/js/pages-controllers/TurbinaViewController.js"></script>
<div class="dashboard-container">
    <!-- ===== HEADER ===== -->
    <header class="app-header">
        <div class="logo-mark">ALPHA <span>ENERGY</span></div>
        <div class="user-chip">
            <div class="avatar-circle">AD</div>
            <div>
                <div class="user-name">Admin Principal</div>
                <div class="user-role">Administrador</div>
            </div>
        </div>
    </header>
    <!-- ===== LAYOUT (sidebar + contenido) ===== -->
    <div class="app-layout">
        <!-- ===== sidebar ===== -->
        <nav class="app-sidebar">
            <div class="s-label">Menu</div>
            <a class="s-item" asp-page="/PanelAdministrador" data-roles="1,3">Dashboard</a>
            <a class="s-item" asp-page="/GestionDeUsuarios" data-roles="1,3">Usuarios</a>
            <a class="s-item active" asp-page="/GestionDeTurbinas" data-roles="1,3">Turbinas</a>
            <a class="s-item" asp-page="/RegistroDeMantenimiento" data-roles="1,3">Mantenimiento</a>
            <a class="s-item" asp-page="/PortalDistribuidor" data-roles="1,2,3">Distribución</a>
            <a class="s-item" asp-page="/MisSolicitudesDistribuidor" data-roles="1,2,3">Mis Solicitudes</a>
            <a class="s-item" asp-page="/AlmacenCentral" data-roles="1,3">Almacén Central</a>
            <a class="s-item" asp-page="/ReporteDeFacturacion" data-roles="1,2,3">Reportes</a>
            <a class="s-item" asp-page="/Auditoria" data-roles="1,3">Auditoría</a>
            <a class="s-item" asp-page="/Perfil" data-roles="1,2,3">Mi Perfil</a>
            <a class="s-item logout" href="/Login">Cerrar sesión</a>
        </nav>
        <!-- ===== CONTENIDO ===== -->
        <main class="app-content">
            <!-- ===== TÍTULO ===== -->
            <div class="page-title-row">
                <div>
                    <div class="page-title">Gestión de Turbinas</div>
                    <div class="page-sub">Gestión y monitoreo de unidades generadoras</div>
                </div>
                <button class="btn-primary" id="btnAgregarTurbina">+ Agregar Turbina</button>
            </div>
            <!-- ===== ESTADÍSTICAS ===== -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Total Turbinas</div>
                    <div class="stat-value" id="statTotal">0</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">En Operación</div>
                    <div class="stat-value" id="statOperacion">0</div>
                    <div class="stat-delta green" id="statOperacionDelta">79% del total</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Mantenimiento</div>
                    <div class="stat-value" id="statMantenimiento">0</div>
                    <div class="stat-delta yellow" id="statMantenimientoDelta">12.5% del total</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Capacidad Total</div>
                    <div class="stat-value" id="statCapacidad">0 <span>MW</span></div>
                    <div class="stat-delta" id="statCapacidadDelta">+0.8 MW vs 2025</div>
                </div>
            </div>
            <!-- ===== FILTROS ===== -->
            <div class="filters-row">
                <div class="search-box-wrapper">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="search-icon">
                        <circle cx="7" cy="7" r="5" stroke="#aaa" stroke-width="1.5" />
                        <path d="M11 11l3 3" stroke="#aaa" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <input id="searchInput" type="text" placeholder="Buscar por modelo o código..." />
                </div>
                <button class="filter-btn" id="btnFilterEstado">Estado ☰</button>
                <button class="filter-btn" id="btnFilterPotencia">Potencia ▽</button>
            </div>
            <!-- ===== TABLA ===== -->
            <table class="wf-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Modelo</th>
                        <th>Marca</th>
                        <th>Cap. Nominal</th>
                        <th>Estado</th>
                        <th>Instalación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyTurbinas">
                </tbody>
            </table>
            <!-- ===== PAGINACIÓN ===== -->
            <div class="pagination-row">
                <span class="pagination-info" id="paginationInfo">Mostrando 0 de 0 turbinas</span>
            </div>
            <!-- ===== ANOTACIÓN ===== -->
            <div class="annotation-section">
                <span class="ann">⚡ Las turbinas con estado "Mantenimiento" requieren revisión técnica</span>
            </div>
        </main>
    </div>
    <!-- ===== FOOTER ===== -->
    <footer class="wf-footer">
        <p>&copy; 2026 Alpha Energy. Todos los derechos reservados.</p>
    </footer>
    <div class="modal-overlay" id="modalOverlay" style="display:none;">
        <div class="modal-card">
            <div class="modal-header">
                <button type="button" class="modal-close" id="btnCerrarModal">x</button>
                <h2 id="modalTitle">Agregar Turbina</h2>
            </div>
            <div class="form-group">
                <label class="field-label">Nombre <span class="required">*</span></label>
                <input id="txtNombre" type="text" class="field-input" placeholder="Nombre de la turbina" />
            </div>
            <div class="form-group">
                <label class="field-label">Modelo <span class="required">*</span></label>
                <input id="txtModelo" type="text" class="field-input" placeholder="Modelo" />
            </div>
            <div class="form-group">
                <label class="field-label">Marca <span class="required">*</span></label>
                <input id="txtMarca" type="text" class="field-input" placeholder="Marca" />
            </div>
            <div class="form-group">
                <label class="field-label">Año de Fabricación <span class="required">*</span></label>
                <input id="txtAnio" type="number" class="field-input" placeholder="Ej: 2023" />
            </div>
            <div class="form-group">
                <label class="field-label">Capacidad (kWh) <span class="required">*</span></label>
                <input id="txtCapacidad" type="number" step="0.01" class="field-input" placeholder="Ej: 450" />
            </div>
            <div class="form-group">
                <label class="field-label">Estado <span class="required">*</span></label>
                <select id="selEstado" class="field-input">
                    <option value="Activa">Activa</option>
                    <option value="Fuera de Servicio">Fuera de Servicio</option>
                </select>
            </div>
            <button type="button" class="btn-primary" id="btnCrearTurbina">Crear</button>
        </div>
    </div>
</div>