@page
@model WebApp.Pages.PerfilModel

@{
    Layout = null;
    ViewData["Title"] = "Mi Perfil";
}

<link rel="stylesheet" href="~/css/paneladministrador.css" />
<link rel="stylesheet" href="~/css/GestionDeUsuarios.css" />
<link rel="stylesheet" href="~/css/cerrarsesion.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/ControlActions.js"></script>
<script>
    var ca = new ControlActions();
    if (ca.VerificarAccesoPagina([1, 2, 3])) {
    $(document).ready(function () {
    ca.AplicarPermisosSidebar();
    ca.RellenarHeaderUsuario();
    });
    }
</script>

<style>
    .perfil-layout {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 20px;
        align-items: start;
    }

    @@media (max-width: 820px) {
        .perfil-layout {
            grid-template-columns: 1fr;
        }
    }

    .perfil-side-card {
        background: #fff;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        padding: 28px 20px;
        text-align: center;
    }

    .perfil-avatar-big {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 700;
        margin: 0 auto 14px;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
    }

    .perfil-nombre-completo {
        font-size: 16px;
        font-weight: 700;
        color: #111;
        margin-bottom: 6px;
    }

    .perfil-info-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 600;
        color: #2563eb;
        background: #eff6ff;
        border-radius: 20px;
        padding: 4px 14px;
    }

    .perfil-meta {
        font-size: 11px;
        color: #9ca3af;
        margin-top: 10px;
    }

    .perfil-side-divider {
        border: none;
        border-top: 1px solid #f0f0f0;
        margin: 20px 0;
    }

    .perfil-side-action {
        display: block;
        width: 100%;
        text-align: left;
        padding: 10px 14px;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .perfil-side-action:hover {
            border-color: #2563eb;
            color: #2563eb;
            background: #eff6ff;
        }

    .perfil-form-card {
        background: #fff;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        padding: 26px 28px;
    }

    .perfil-section-label {
        font-size: 11px;
        font-weight: 700;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        margin-bottom: 14px;
    }
</style>

<div class="dashboard-container">

    <!-- ===== header ===== -->
    <header class="app-header">
        <div class="logo-mark">ALPHA <span>ENERGY</span></div>
        <div class="user-chip">
            <div class="avatar-circle">--</div>
            <div>
                <div class="user-name">Cargando...</div>
                <div class="user-role"></div>
            </div>
        </div>
    </header>

    <!-- ===== layout ===== -->
    <div class="app-layout">

        <!-- ===== sidebar ===== -->
        <nav class="app-sidebar">
            <div class="s-label">Menu</div>
            <a class="s-item" asp-page="/DashboardDistribuidor" data-roles="2">Dashboard</a>
            <a class="s-item" asp-page="/PanelAdministrador" data-roles="1,3">Dashboard</a>
            <a class="s-item" asp-page="/GestionDeUsuarios" data-roles="1,3">Usuarios</a>
            <a class="s-item" asp-page="/GestionDeTurbinas" data-roles="1,3">Turbinas</a>
            <a class="s-item" asp-page="/RegistroDeMantenimiento" data-roles="1,3">Mantenimiento</a>
            <a class="s-item" asp-page="/PortalDistribuidor" data-roles="1,3">Distribución</a>
            <a class="s-item" asp-page="/MisSolicitudesDistribuidor" data-roles="2">Mis Solicitudes</a>
            <a class="s-item" asp-page="/AlmacenCentral" data-roles="1,3">Almacén Central</a>
            <a class="s-item" asp-page="/ReporteDeFacturacion" data-roles="1,2,3">Reportes</a>
            <a class="s-item" asp-page="/Auditoria" data-roles="1,3">Auditoría</a>
            <a class="s-item active" asp-page="/Perfil" data-roles="1,2,3">Mi Perfil</a>
            <a class="s-item logout" href="/Login">Cerrar sesión</a>
        </nav>

        <!-- ===== content ===== -->
        <div class="app-content">

            <!-- ===== título ===== -->
            <div class="page-title-row">
                <div>
                    <div class="page-title">Mi Perfil</div>
                    <div class="page-sub">Datos de tu cuenta</div>
                </div>
            </div>

            <div class="perfil-layout">

                <!-- ===== TARJETA LATERAL ===== -->
                <div class="perfil-side-card">
                    <div class="perfil-avatar-big" id="perfilAvatar">--</div>
                    <div class="perfil-nombre-completo" id="perfilNombreCompleto">Cargando...</div>
                    <span class="perfil-info-badge" id="perfilRolBadge">-</span>
                    <div class="perfil-meta" id="perfilMiembroDesde"></div>

                    <hr class="perfil-side-divider" />

                    <button type="button" class="perfil-side-action" id="btnCambiarContrasena">🔒 Cambiar Contraseña</button>
                </div>

                <!-- ===== FORMULARIO ===== -->
                <div class="perfil-form-card">
                    <div class="perfil-section-label">Información Personal</div>

                    <form id="formPerfil">
                        <div class="form-group">
                            <label class="field-label">Identificación</label>
                            <input id="txtIdentificacion" class="field-input" disabled />
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="field-label">Nombre</label>
                                <input id="txtNombre" class="field-input" />
                            </div>
                            <div class="form-group">
                                <label class="field-label">Primer Apellido</label>
                                <input id="txtApellido1" class="field-input" />
                            </div>
                            <div class="form-group">
                                <label class="field-label">Segundo Apellido</label>
                                <input id="txtApellido2" class="field-input" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="field-label">Correo</label>
                                <input id="txtCorreo" type="email" class="field-input" />
                            </div>
                            <div class="form-group">
                                <label class="field-label">Teléfono</label>
                                <input id="txtTelefono" class="field-input" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="field-label">Fecha de Nacimiento</label>
                                <input id="txtFechaNacimiento" type="date" class="field-input" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="field-label">Foto de Perfil (URL)</label>
                            <input id="txtFotoPerfil" class="field-input" />
                        </div>

                        <div class="modal-footer" style="padding:16px 0 0;border-top:none;justify-content:flex-end;">
                            <button id="btnGuardarPerfil" type="submit" class="btn-primary">Guardar Cambios</button>
                        </div>
                    </form>
                </div>

            </div>

        </div>

    </div>

    <!-- ===== footer ===== -->
    <div class="wf-footer">
        &copy; 2026 Alpha Energy. Todos los derechos reservados.
    </div>

</div>

<!-- ===== MODAL: CAMBIAR CONTRASEÑA CON OTP ===== -->
<div class="modal-overlay" id="modalCambiarContrasena" style="display:none;">
    <div class="modal-box" style="max-width:440px;">
        <div class="modal-header">
            <h2>Cambiar Contraseña</h2>
            <button type="button" class="modal-close" id="btnCerrarModalContrasena">&times;</button>
        </div>
        <div class="modal-body">
            <div id="pasoSolicitarOtp">
                <p style="font-size:13px;color:#6b7280;margin-bottom:16px;">
                    Te vamos a enviar un código de verificación a <strong id="correoDestinoOtp"></strong> para confirmar el cambio.
                </p>
                <button type="button" class="btn-primary" id="btnEnviarCodigoOtp" style="width:100%;">Enviar Código</button>
            </div>
            <div id="pasoConfirmarOtp" style="display:none;">
                <div class="form-group">
                    <label class="field-label">Código de Verificación</label>
                    <input id="txtOtpPerfil" class="field-input" maxlength="6" placeholder="000000" />
                </div>
                <div class="form-group">
                    <label class="field-label">Nueva Contraseña</label>
                    <input id="txtNuevaContrasenaPerfil" type="password" class="field-input" placeholder="Al menos 8 caracteres" />
                </div>
                <div class="form-group">
                    <label class="field-label">Confirmar Nueva Contraseña</label>
                    <input id="txtConfirmarContrasenaPerfil" type="password" class="field-input" />
                </div>
                <button type="button" class="btn-primary" id="btnConfirmarCambioContrasena" style="width:100%;margin-bottom:10px;">Cambiar Contraseña</button>
                <a href="#" id="btnReenviarCodigoPerfil" style="display:block;text-align:center;font-size:12px;color:#2563eb;">¿No recibiste el código? Reenviar</a>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-outline" id="btnCancelarContrasena">Cerrar</button>
        </div>
    </div>
</div>

<script src="~/js/pages-controllers/PerfilViewController.js"></script>