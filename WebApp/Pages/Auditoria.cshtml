@page
@model WebApp.Pages.AuditoriaModel
@{
    Layout = null;
    ViewData["Title"] = "Auditoría";
}
<link rel="stylesheet" href="~/css/paneladministrador.css" />
<link rel="stylesheet" href="~/css/cerrarsesion.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<link href="https://cdn.datatables.net/2.3.8/css/dataTables.dataTables.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/gestiondeusuarios.css" />
<script src="https://cdn.datatables.net/2.3.8/js/dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/ControlActions.js"></script>
<script>
    var ca = new ControlActions();
    if (ca.VerificarAccesoPagina([1, 3])) {
    $(document).ready(function () {
    ca.AplicarPermisosSidebar();
    ca.RellenarHeaderUsuario();
    });
    }
</script>
<script src="~/js/pages-controllers/AuditoriaViewController.js"></script>
<div class="dashboard-container">
    <!-- ===== HEADER ===== -->
    <header class="app-header">
        <div class="logo-mark">ALPHA <span>ENERGY</span></div>
        <div class="user-chip">
            <div class="avatar-circle">AD</div>
            <div>
                <div class="user-name">Admin Principal</div>
                <div class="user-role">Administrador</div>
            </div>
        </div>
    </header>
    <!-- ===== LAYOUT (sidebar + contenido) ===== -->
    <div class="app-layout">
        <!-- ===== sidebar ===== -->
        <nav class="app-sidebar">
            <div class="s-label">Menu</div>
            <a class="s-item" asp-page="/PanelAdministrador" data-roles="1,3">Dashboard</a>
            <a class="s-item" asp-page="/GestionDeUsuarios" data-roles="1,3">Usuarios</a>
            <a class="s-item" asp-page="/GestionDeTurbinas" data-roles="1,3">Turbinas</a>
            <a class="s-item" asp-page="/RegistroDeMantenimiento" data-roles="1,3">Mantenimiento</a>
            <a class="s-item" asp-page="/PortalDistribuidor" data-roles="1,2,3">Distribución</a>
            <a class="s-item" asp-page="/AlmacenCentral" data-roles="1,3">Almacén Central</a>
            <a class="s-item" asp-page="/ReporteDeFacturacion" data-roles="1,2,3">Reportes</a>
            <a class="s-item active" asp-page="/Auditoria" data-roles="1,3">Auditoría</a>
            <a class="s-item logout" href="/Login">Cerrar sesión</a>
        </nav>
        <!-- ===== CONTENIDO ===== -->
        <main class="app-content">
            <!-- ===== TÍTULO ===== -->
            <div class="page-title-row">
                <div>
                    <div class="page-title">Auditoría del Sistema</div>
                    <div class="page-sub">Historial de cambios realizados en Turbinas, Mantenimientos y Usuarios</div>
                </div>
            </div>
            <!-- ===== FILTROS ===== -->
            <div class="filters-row">
                <select id="selFiltroEntidad" class="filter-btn">
                    <option value="">Todas las entidades</option>
                    <option value="Turbina">Turbina</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                    <option value="Usuario">Usuario</option>
                </select>
                <input id="txtFechaInicio" type="date" class="field-input" style="max-width:170px;" title="Desde" />
                <input id="txtFechaFin" type="date" class="field-input" style="max-width:170px;" title="Hasta" />
                <button class="btn-primary" id="btnAplicarFiltros">Aplicar filtros</button>
                <button class="btn-outline" id="btnLimpiarFiltros">Limpiar</button>
            </div>
            <!-- ===== TABLA (DataTables construye thead/tbody automáticamente) ===== -->
            <table id="tblAuditoria" class="wf-table">
            </table>
            <!-- ===== ANOTACIÓN ===== -->
            <div class="annotation-section">
                <span class="ann">📋 Los registros de auditoría son de solo lectura y no pueden editarse ni eliminarse</span>
            </div>
        </main>
    </div>
    <!-- ===== FOOTER ===== -->
    <footer class="wf-footer">
        <p>&copy; 2026 Alpha Energy. Todos los derechos reservados.</p>
    </footer>
</div>