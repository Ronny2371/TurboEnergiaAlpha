@page
@model WebApp.Pages.ReporteDeFacturacionModel
@{
    Layout = null;
    ViewData["Title"] = "Reporte de Facturación";
}
<link rel="stylesheet" href="~/css/reportedefacturacion.css" />
<link rel="stylesheet" href="~/css/paneladministrador.css" />
<link rel="stylesheet" href="~/css/cerrarsesion.css" />
<!-- stats-grid/stat-card y wf-table ya definidos aqui, se reutilizan -->
<link rel="stylesheet" href="~/css/gestiondeturbinas.css" />
<link rel="stylesheet" href="~/css/portaldistribuidor.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/ControlActions.js"></script>
<script>
    var ca = new ControlActions();
    if (ca.VerificarAccesoPagina([1, 2, 3])) {
    $(document).ready(function () {
    ca.AplicarPermisosSidebar();
    ca.RellenarHeaderUsuario();
    });
    }
</script>
<script src="~/js/pages-controllers/ReporteFacturacionViewController.js"></script>
<div class="dashboard-container">
    <!-- ===== HEADER ===== -->
    <header class="app-header">
        <div class="logo-mark">ALPHA <span>ENERGY</span></div>
        <div class="user-chip">
            <div class="avatar-circle">DS</div>
            <div>
                <div class="user-name">Distribuidora del Sur S.A.</div>
                <div class="user-role">Distribuidor</div>
            </div>
        </div>
    </header>
    <!-- ===== LAYOUT (sidebar + contenido lado a lado) ===== -->
    <div class="app-layout">
        <!-- ===== sidebar ===== -->
        <nav class="app-sidebar">
            <div class="s-label">Menu</div>
            <a class="s-item" asp-page="/PanelAdministrador" data-roles="1,3">Dashboard</a>
            <a class="s-item" asp-page="/GestionDeUsuarios" data-roles="1,3">Usuarios</a>
            <a class="s-item" asp-page="/GestionDeTurbinas" data-roles="1,3">Turbinas</a>
            <a class="s-item" asp-page="/RegistroDeMantenimiento" data-roles="1,3">Mantenimiento</a>
            <a class="s-item" asp-page="/PortalDistribuidor" data-roles="1,2,3">Distribución</a>
            <a class="s-item" asp-page="/AlmacenCentral" data-roles="1,3">Almacén Central</a>
            <a class="s-item active" asp-page="/ReporteDeFacturacion" data-roles="1,2,3">Reportes</a>
            <a class="s-item" asp-page="/Auditoria" data-roles="1,3">Auditoría</a>
            <a class="s-item" asp-page="/Perfil" data-roles="1,2,3">Mi Perfil</a>
            <a class="s-item logout" href="/Login">Cerrar sesión</a>
        </nav>
        <!-- ===== CONTENIDO ===== -->
        <main class="app-content">
            <div class="facturacion-card" id="reporteContent">
                <div class="facturacion-header">
                    <h1 class="facturacion-title">Reporte de Distribución</h1>
                    <p class="facturacion-desc">Resumen financiero del período facturado</p>
                </div>
                <!-- ===== BOTONES DE ACCIÓN ===== -->
                <div class="action-bar no-print">
                    <button class="btn-outline btn-pdf" onclick="descargarPDF()">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M8 1v9M4 6l4 4 4-4" stroke="#555" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M2 12h12" stroke="#555" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                        Descargar PDF
                    </button>
                    <button class="btn-outline btn-print" onclick="window.print()">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <rect x="2" y="4" width="12" height="10" rx="1" stroke="#555" stroke-width="1.4" />
                            <path d="M5 4V3a1 1 0 011-1h4a1 1 0 011 1v1" stroke="#555" stroke-width="1.4" />
                            <path d="M5 9h6M5 12h4" stroke="#555" stroke-width="1.3" stroke-linecap="round" />
                        </svg>
                        Imprimir
                    </button>
                </div>
                <!-- ===== PERIOD HEADER CARD ===== -->
                <div class="report-header-card">
                    <div>
                        <div class="report-period" id="lblPeriodo">—</div>
                        <div class="report-period-sub">Período de facturación</div>
                    </div>
                    <div class="report-meta">
                        <div class="meta-item">
                            <span class="meta-label">Distribuidor</span>
                            <span class="meta-value" id="lblDistribuidor">—</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">No. Factura</span>
                            <span class="meta-value code" id="lblNumeroFactura">—</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Estado</span>
                            <span class="badge badge-blue" id="badgeEstado">
                                <span class="badge-dot badge-dot-blue" id="badgeEstadoDot"></span>
                                <span id="lblEstado">—</span>
                            </span>
                        </div>
                    </div>
                </div>
                <!-- ===== GRID ===== -->
                <div class="report-grid">
                    <!-- ===== Factura ===== -->
                    <div class="invoice-card">
                        <div class="invoice-title">Desglose de Cobros</div>
                        <div class="invoice-row">
                            <span class="lbl">Energía Asignada</span>
                            <span class="val" id="lblEnergiaAsignada">—</span>
                        </div>
                        <div class="invoice-row">
                            <span class="lbl">Precio por MWh</span>
                            <span class="val" id="lblPrecioMWh">—</span>
                        </div>
                        <div class="invoice-row subtotal">
                            <span class="lbl">Subtotal</span>
                            <span class="val" id="lblSubtotal">—</span>
                        </div>
                        <div class="invoice-row">
                            <span class="lbl" id="lblImpuestoLabel">Impuesto</span>
                            <span class="val tax" id="lblImpuesto">—</span>
                        </div>
                        <div class="invoice-total">
                            <span>Total a Pagar</span>
                            <span id="lblTotal">—</span>
                        </div>
                        <div class="invoice-note">
                            <span class="ann">Precios definidos por administrador al aprobar solicitud</span>
                        </div>
                    </div>
                    <!-- ===== DETAllE ===== -->
                    <div>
                        <div class="chart-card">
                            <div class="chart-title">Composición del Total</div>
                            <svg viewBox="0 0 280 70" width="100%" style="display:block;">
                                <rect x="10" y="20" width="260" height="24" rx="4" fill="#f3f4f6" />
                                <rect id="barSubtotal" x="10" y="20" width="0" height="24" fill="#111" />
                                <rect id="barImpuesto" x="10" y="20" width="0" height="24" fill="#ef4444" />
                                <text x="10" y="60" font-size="9" fill="#6b7280">Subtotal <tspan id="lblChartSubtotalPct" font-weight="700" fill="#111">0%</tspan></text>
                                <text x="270" y="60" text-anchor="end" font-size="9" fill="#6b7280">Impuesto <tspan id="lblChartImpuestoPct" font-weight="700" fill="#ef4444">0%</tspan></text>
                            </svg>
                            <div class="chart-note">Proporción de Subtotal e Impuesto dentro del Total a Pagar</div>
                        </div>
                        <div class="notes-card">
                            <div class="notes-title">Notas del Período</div>
                            <div class="notes-list" id="notasList">
                            </div>
                        </div>
                    </div>
                </div>
                <!-- ===== EXTRA DISTRIBUIDOR (solo visible para rol Distribuidor) ===== -->
                <div id="distribuidorExtraSection" style="display:none;">
                    <div class="stats-grid" style="margin-top:24px;">
                        <div class="stat-card">
                            <div class="stat-label">Solicitudes Activas del Año</div>
                            <div class="stat-value" id="statSolicitudesActivas">0</div>
                            <div class="stat-delta" id="statSolicitudesLimite"></div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Volumen Total Distribuido</div>
                            <div class="stat-value" id="statVolumenDistribuido">0 <span style="font-size:11px;color:#9ca3af;">MWh</span></div>
                        </div>
                    </div>
                    <div class="notes-card" style="margin-top:16px;">
                        <div class="notes-title">Historial de Solicitudes de Compra</div>
                        <table class="wf-table">
                            <thead>
                                <tr>
                                    <th>Mes / Año</th>
                                    <th>Cantidad (MWh)</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyHistorialSolicitudes"></tbody>
                        </table>
                    </div>
                    <div class="notes-card" style="margin-top:16px;">
                        <div class="notes-title">Detalle de Facturación por Distribución</div>
                        <table class="wf-table">
                            <thead>
                                <tr>
                                    <th>Período</th>
                                    <th>No. Factura</th>
                                    <th>Estado</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyDetalleFacturacion"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <!-- ===== FOOTER ===== -->
    <footer class="wf-footer">
        <p>&copy; 2026 Alpha Energy. Todos los derechos reservados.</p>
    </footer>
</div>
<!-- ===== SCRIPTS ===== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    function descargarPDF() {
    const elemento = document.getElementById('reporteContent');
    const periodo = (window.distribucionActual ? $('#lblPeriodo').text() : 'Reporte').replace(/\s+/g, '');
    const opciones = {
    margin: 10,
    filename: 'Reporte_Distribucion_' + periodo + '.pdf',
    image: { type: 'jpeg', quality: 0.98 },
    html2canvas: { scale: 2, useCORS: true },
    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };
    html2pdf().set(opciones).from(elemento).save();
    }
</script>
